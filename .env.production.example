APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_PLESK_DB_NAME
DB_USERNAME=REPLACE_WITH_PLESK_DB_USER
DB_PASSWORD=REPLACE_WITH_PLESK_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# เมื่อพร้อมส่งอีเมลจริง เปลี่ยน MAIL_MAILER=smtp แล้วกรอกค่าให้ตรงกับผู้ให้บริการอีเมลที่ใช้
# (เช่น Gmail SMTP: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=อีเมล, MAIL_PASSWORD=App Password)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@chilldoicampingandfarm.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=

